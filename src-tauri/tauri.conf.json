{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hazpenztar",
  "version": "0.1.3",
  "identifier": "com.deme.hazpenztar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Társasház Óvoda utca 6/a házpénztár",
        "width": 1200,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "f8f9fe9b-1a00-5dd2-ae41-7e21f625d15e"
      }
    }
  }
}
